# Docker Compose settings (copy to .env next to docker-compose.yml).
# For running the apps separately, use frontend/.env.example and
# backend/.env.example instead.

# Required by Docker Compose. Replace these with distinct random secrets and
# your public frontend origin before starting a deployment.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CLIENT_URL=
# Same origin behind Nginx, so lax cookies are right for Compose.
COOKIE_SAMESITE=lax
MAX_OUTPUT_TOKENS=2048

# Optional backend provider and admin settings for Docker Compose.
ADMIN_EMAILS=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai
DEFAULT_AI_MODEL=qwen/qwen3.8-27b
REFRESH_TOKEN_TTL_DAYS=7
RESEND_API_KEY=
OTP_FROM_EMAIL=onboarding@resend.dev
VLY_INTEGRATION_KEY=
VLY_INTEGRATION_BASE_URL=https://integrations.freebuff.com
