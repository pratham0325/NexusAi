# Frontend (Vite) build-time variables. These are PUBLIC — they end up in the
# browser bundle. Never put API keys or secrets here.

# Full URL of the backend API, including the /api suffix, e.g.
#   VITE_API_URL=https://api.example.com/api
# Leave unset when the frontend is served behind the included Nginx proxy
# (Docker Compose), which forwards same-origin /api requests to the backend.
VITE_API_URL=

# Optional Vly error reporting.
VITE_VLY_APP_ID=
VITE_VLY_MONITORING_URL=
