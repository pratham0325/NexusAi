NODE_ENV=development
PORT=5000
# Local: mongodb://127.0.0.1:27017/nexusai
# Atlas: mongodb+srv://<user>:<password>@<cluster>/nexusai?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nexusai

# Generate two DIFFERENT random values with: openssl rand -hex 32
# Production refuses to start with missing, short, identical or placeholder values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated allowed frontend origins (scheme + host, no path).
# Production requires https (http is allowed only for localhost).
CLIENT_URL=http://localhost:5173
# lax  = frontend and API on the same site (same domain, or app./api. subdomains)
# none = frontend and API on different sites (e.g. *.vercel.app + *.onrender.com)
# Default: lax in development, none in production.
COOKIE_SAMESITE=
# Number of reverse proxies in front of the API (Render/Railway/Nginx: 1).
TRUST_PROXY=1

# Comma-separated allowlist for the first admin claim. The account must have
# signed in with an email code at least once (verified address). Alternative:
# npm run grant-admin -- you@example.com
ADMIN_EMAILS=

# Optional AI provider settings. With no key, NexusAI uses its demo provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai
DEFAULT_AI_MODEL=qwen/qwen3.8-27b
VLY_INTEGRATION_KEY=
VLY_INTEGRATION_BASE_URL=https://integrations.freebuff.com

# Cost controls.
MAX_OUTPUT_TOKENS=2048
MAX_CONCURRENT_GENERATIONS=2

# Optional outbound email settings (required for email-code sign-in in production).
RESEND_API_KEY=
OTP_FROM_EMAIL=onboarding@resend.dev
# Local development only — prints codes to the console. Production refuses true.
ENABLE_DEV_OTP=true
